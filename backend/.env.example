# Fantasy Competition Backend — Environment Variables
# Copy this file to .env and adjust values as needed.
# The backend works out of the box without a .env file (defaults shown below).

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# SQLite (default, good for local development only):
# WARNING: On Render and other ephemeral filesystems, SQLite data is lost
# on every deploy/restart. Use PostgreSQL for any persistent deployment.
DATABASE_URL=sqlite:///./fantasy_competition.db

# PostgreSQL example (recommended for production):
# DATABASE_URL=postgresql://user:password@host:5432/fantasy_competition

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
